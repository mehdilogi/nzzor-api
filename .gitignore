# =============================================================================
# Nzzor API — .gitignore
# =============================================================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Build artifacts
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log

# Prisma local files
prisma/_orphan_*
prisma/dev.db
prisma/dev.db-journal

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor configs
.vscode/
.idea/
*.swp
*.swo
*~

# Snapshots / archives — sometimes generated locally for backups
*.tar.gz
*.tar
*.zip
nzzor-*-snapshot.*

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/

# Temp
tmp/
temp/

// =============================================================================
// Nzzor — Proprietary Travel Database Schema
// Operated by Allouni Travel Agency
// =============================================================================
// Design principles:
// 1. Multilingual first — ar/fr/en on every customer-facing field
// 2. Soft deletes via isActive flags
// 3. Full audit trail
// 4. Designed for Phase 2 (tours) + Phase 3 (flights) without rewriting
// 5. Pricing snapshots at booking time — never recalculate historical prices
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USERS & AUTH
// =============================================================================

enum UserRole {
  CUSTOMER
  HOTEL_MANAGER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          UserRole  @default(CUSTOMER)

  firstName     String?
  lastName      String?
  preferredLang String    @default("fr")

  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?

  // Password reset — token is generated as a random 32-byte value, mailed
  // to the user as a URL fragment, and stored here as a SHA-256 hash so a
  // database leak doesn't expose live reset links. Token is single-use
  // (nulled out on successful reset) and expires 1 hour after issue.
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?

  bookings      Booking[]
  reviews       Review[]
  managedHotels HotelManager[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@map("users")
}

model HotelManager {
  id      String @id @default(uuid())
  userId  String
  hotelId String

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
  @@map("hotel_managers")
}

// Property-level availability — the hotel marks days as closed (the whole
// hotel is hidden from search on those dates). A row only exists for CLOSED
// days; absence of a row means OPEN. Kept simple for v1; can graduate to
// per-room-type later without breaking the API.
model HotelAvailability {
  id      String   @id @default(uuid())
  hotelId String
  date    DateTime @db.Date
  isClosed Boolean @default(true)
  note    String?

  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, date])
  @@index([hotelId, date])
  @@map("hotel_availability")
}

// =============================================================================
// HOTELS
// =============================================================================

model Hotel {
  id          String  @id @default(uuid())
  slug        String  @unique

  // Multilingual content
  nameEn      String
  nameFr      String
  nameAr      String
  descEn      String  @db.Text
  descFr      String  @db.Text
  descAr      String  @db.Text

  stars       Int

  // Location
  city        String  // Normalized: "algiers", "oran"
  cityEn      String
  cityFr      String
  cityAr      String
  regionEn    String
  regionFr    String
  regionAr    String
  address     String?
  latitude    Float?
  longitude   Float?

  // Policies
  checkInTime       String  @default("14:00")
  checkOutTime      String  @default("12:00")
  cancellationHours Int     @default(48)
  childrenAllowed   Boolean @default(true)
  petsAllowed       Boolean @default(false)
  parkingFree       Boolean @default(true)

  // Contact
  contactEmail  String?
  contactPhone  String?
  website       String?

  // Aggregated ratings
  rating        Float   @default(0)
  reviewCount   Int     @default(0)

  // Trust signals
  instantConfirmation Boolean @default(true) // Brand promise — only hotels that commit
  verifiedPartner     Boolean @default(true) // Allouni-verified

  // Status
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  sortOrder     Int     @default(0)

  // AI-search tags — see TAG_DICTIONARY in src/utils/tags.js for canonical keys
  tags          String[] @default([])

  rooms         Room[]
  photos        HotelPhoto[]
  amenities     HotelAmenity[]
  bookings      Booking[]
  reviews       Review[]
  managers      HotelManager[]
  availability  HotelAvailability[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([stars])
  @@index([isActive, isFeatured])
  @@index([slug])
  @@map("hotels")
}

// =============================================================================
// ROOMS & PRICING
// =============================================================================

model Room {
  id        String @id @default(uuid())
  hotelId   String

  typeEn    String
  typeFr    String
  typeAr    String
  descEn    String? @db.Text
  descFr    String? @db.Text
  descAr    String? @db.Text

  capacity  Int
  sizeSqm   Int?
  bedType   String

  basePrice Int     // DZD per night

  totalUnits Int    @default(1)

  breakfastIncluded Boolean @default(true)  // free breakfast offered (supplement 0) unless turned off

  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  hotel      Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rates      RoomRate[]
  boardRates RoomBoardRate[]
  bookings   BookingRoom[]
  photos     RoomPhoto[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hotelId, isActive])
  @@map("rooms")
}

model RoomRate {
  id        String   @id @default(uuid())
  roomId    String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  price     Int

  rateType  String   @default("standard") // standard, weekend, holiday, promo
  label     String?

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([roomId, startDate, endDate])
  @@map("room_rates")
}

// -----------------------------------------------------------------------------
// BOARD / MEAL-PLAN RATES  (Phase B — booking engine v2)
// -----------------------------------------------------------------------------
// Distinct from RoomRate above. RoomRate is SEASONAL/date-range pricing
// (standard/weekend/holiday/promo). RoomBoardRate is the MEAL-PLAN axis:
// the per-night price of a room WITH a given board arrangement.
//
// Pricing is ABSOLUTE (the full per-room-per-night price for that board), not
// a delta over basePrice — simpler for admin entry and for the quote engine to
// sum across rooms. A room's `basePrice` remains the ROOM_ONLY fallback for
// any room that has no board rates yet, so nothing existing breaks.
//
// One row per (room, board); unset boards simply don't exist as rows and are
// treated as "not offered".
// -----------------------------------------------------------------------------

enum BoardType {
  ROOM_ONLY      // Chambre seule — no meals
  BREAKFAST      // Petit Déjeuner (BB)
  HALF_BOARD     // Demi-pension (DP+) — breakfast + one meal
  FULL_BOARD     // Pension complète (PC+) — all meals
  ALL_INCLUSIVE  // Soft All Inclusive
}

model RoomBoardRate {
  id        String    @id @default(uuid())
  roomId    String

  board     BoardType
  price     Int       // legacy ABSOLUTE price; kept for back-compat, no longer the source of truth
  supplement Int      @default(0)  // DZD per room per night ADDED to the room's basePrice (ROOM_ONLY = 0)
  isActive  Boolean   @default(true)

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roomId, board])
  @@index([roomId])
  @@map("room_board_rates")
}

// =============================================================================
// PHOTOS
// =============================================================================

model HotelPhoto {
  id        String  @id @default(uuid())
  hotelId   String
  url       String
  altEn     String?
  altFr     String?
  altAr     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([hotelId, sortOrder])
  @@map("hotel_photos")
}

model RoomPhoto {
  id        String  @id @default(uuid())
  roomId    String
  url       String
  sortOrder Int     @default(0)

  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("room_photos")
}

// =============================================================================
// AMENITIES
// =============================================================================

model Amenity {
  id       String @id @default(uuid())
  key      String @unique
  nameEn   String
  nameFr   String
  nameAr   String
  icon     String?
  category String  @default("general")

  hotels   HotelAmenity[]

  @@map("amenities")
}

model HotelAmenity {
  id        String @id @default(uuid())
  hotelId   String
  amenityId String

  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([hotelId, amenityId])
  @@map("hotel_amenities")
}

// =============================================================================
// BOOKINGS
// =============================================================================

enum BookingStatus {
  PENDING
  ON_REQUEST
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
  REFUNDED
}

enum PaymentMethod {
  CIB
  EDDAHABIA
  CASH
  BANK_TRANSFER
  WHATSAPP_ASSISTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Booking {
  id              String        @id @default(uuid())
  reference       String        @unique  // NZR-XXXX-XXXX

  userId          String?
  guestFirstName  String
  guestLastName   String
  guestEmail      String
  guestPhone      String
  specialRequests String?       @db.Text

  hotelId         String

  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  nights          Int

  // Pricing snapshot at booking time
  subtotal        Int
  taxes           Int           @default(0)
  fees            Int           @default(0)
  discount        Int           @default(0)
  total           Int
  currency        String        @default("DZD")

  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?

  status          BookingStatus @default(PENDING)
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  cancelReason    String?

  source          String        @default("website")
  lang            String        @default("fr")
  ipAddress       String?
  userAgent       String?

  user            User?         @relation(fields: [userId], references: [id])
  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  rooms           BookingRoom[]
  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reference])
  @@index([hotelId, checkIn, checkOut])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingRoom {
  id            String @id @default(uuid())
  bookingId     String
  roomId        String
  quantity      Int    @default(1)
  pricePerNight Int
  board         BoardType?  // chosen meal plan; null = legacy/room-only

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room          Room    @relation(fields: [roomId], references: [id])

  @@map("booking_rooms")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  gatewayRef      String?
  gatewayResponse String?       @db.Text

  isRefund        Boolean       @default(false)
  refundReason    String?

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())

  @@index([bookingId])
  @@index([gatewayRef])
  @@map("payments")
}

// =============================================================================
// REVIEWS
// =============================================================================

model Review {
  id        String  @id @default(uuid())
  userId    String
  hotelId   String

  rating    Float   // 1-10 scale (Booking.com convention)
  titleEn   String?
  titleFr   String?
  titleAr   String?
  bodyEn    String? @db.Text
  bodyFr    String? @db.Text
  bodyAr    String? @db.Text

  isApproved Boolean @default(false)
  isVisible  Boolean @default(true)

  user      User    @relation(fields: [userId], references: [id])
  hotel     Hotel   @relation(fields: [hotelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hotelId])
  @@index([hotelId, isVisible])
  @@map("reviews")
}
// =============================================================================
// ANALYTICS — append the lines below to prisma/schema.prisma
// =============================================================================
// Why a single file: Prisma doesn't support multiple schema files in one
// generate. Copy the content below and paste it at the end of your existing
// prisma/schema.prisma. After pasting:
//   npx prisma migrate dev --name add_analytics
//   npx prisma generate
//
// All four tables map to "analytics_*" so they're visually grouped in
// Prisma Studio without using a separate Postgres schema (which Prisma's
// support for is awkward in Express setups). If we ever need to move to
// a separate physical DB, the @@map names make that straightforward.
// =============================================================================

enum AnalyticsEventType {
  WHATSAPP_CLICK
  BOOKING_CTA_CLICK
  HOTEL_VIEW
  SIGNUP
  LOGIN
  BOOKING_STARTED
  BOOKING_COMPLETED
  SEARCH
}

// Raw pageview events. One row per page load. Retention: 90 days, then
// aggregated into DailyStats and the raw row is deleted by the cron job.
model Pageview {
  id          String   @id @default(uuid())
  visitorId   String                // 1st-party cookie UUID (anonymous)
  userId      String?               // Only set when logged in
  path        String                // /hotels/royal-maqam (no querystring, no domain)
  fullUrl     String?  @db.Text     // Querystring kept for source attribution analysis
  referrer    String?  @db.Text     // document.referrer
  referrerSrc String?               // Classified: "google", "facebook", "direct", "internal", etc.
  ua          String?  @db.Text     // User-Agent header (truncated to 500 chars on insert)
  deviceType  String?               // "mobile", "tablet", "desktop", "bot"
  country     String?               // ISO 3166-1 alpha-2 from CF-IPCountry (e.g. "DZ")
  ipHash      String?               // SHA256 hash of IP, used for unique-visitor counting without storing PII
  lang        String?               // Browser language (ar/fr/en)
  sessionId   String?               // FK to Session — set after server-side bucketing
  isBot       Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
  @@index([path])
  @@index([country])
  @@map("analytics_pageviews")
}

// Sessions cluster pageviews from the same visitor within a 30-minute window.
// One row per session. Retention: same 90 days (kept in sync with Pageview).
model Session {
  id             String    @id @default(uuid())
  visitorId      String                            // Same cookie UUID as Pageview
  userId         String?                           // Set if user is logged in at session start
  startedAt      DateTime  @default(now())
  endedAt        DateTime                          // Updated as new pageviews arrive
  pageviewCount  Int       @default(1)
  entryPath      String                            // First page of the session
  exitPath       String?                           // Last page of the session
  country        String?                           // ISO from CF-IPCountry
  referrerSrc    String?                           // Classified source of the entry pageview
  deviceType     String?
  isBot          Boolean   @default(false)

  // The full Pageview history can be reconstructed via Pageview.sessionId

  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@index([country])
  @@map("analytics_sessions")
}

// Custom events: clicks that matter for the funnel. Cheap and unbounded —
// kept indefinitely so we can analyze long-term conversion patterns.
model AnalyticsEvent {
  id          String              @id @default(uuid())
  visitorId   String                                  // Same cookie UUID
  userId      String?
  sessionId   String?                                 // FK to Session
  type        AnalyticsEventType
  path        String                                  // Page where the event fired
  meta        Json?                                   // Arbitrary payload: { hotelSlug, bookingRef, ... }
  country     String?

  createdAt   DateTime            @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([visitorId, createdAt])
  @@map("analytics_events")
}

// Daily aggregates — populated by the rollup cron each night. The dashboard
// reads from here for any range > 7 days. Raw Pageview rows are deleted
// after 90 days; DailyStats are kept forever.
model DailyStats {
  date              DateTime  @id @db.Date           // PK: one row per UTC day, stored as DATE
  pageviews         Int       @default(0)
  sessions          Int       @default(0)
  uniqueVisitors    Int       @default(0)
  uniqueUsers       Int       @default(0)            // Distinct logged-in userIds
  bookingsCreated   Int       @default(0)            // Count from Booking table
  bookingsConfirmed Int       @default(0)
  avgPageviewsPerSession Float @default(0)
  topPaths          Json?                            // [{ path, count }, ...] top 10
  topCountries      Json?                            // [{ country, count }, ...] top 10
  topReferrerSrcs   Json?                            // [{ src, count }, ...] top 10
  topDevices        Json?                            // [{ device, count }, ...]

  computedAt        DateTime  @default(now()) @updatedAt

  @@map("analytics_daily_stats")
}

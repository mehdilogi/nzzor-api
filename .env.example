# =============================================================================
# Nzzor API — Environment Configuration
# Operated by Allouni Travel Agency
# =============================================================================

# Brand
BRAND_NAME=Nzzor
LEGAL_OPERATOR="Allouni Travel Agency"
MINISTRY_AGREMENT_NUMBER="" # Fill in your Ministry of Tourism agrément number

# Database (PostgreSQL)
# For local development: createdb nzzor
DATABASE_URL="postgresql://postgres:password@localhost:5432/nzzor?schema=public"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Email (Phase 1 Step 8)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="Nzzor <bookings@nzzor.com>"

# Payment Gateways (Phase 1 Step 7 — fill once SATIM merchant account is approved)
# SATIM_MERCHANT_ID=
# SATIM_TERMINAL_ID=
# SATIM_SECRET_KEY=
# SATIM_API_URL=
# EDDAHABIA_API_KEY=
# EDDAHABIA_API_URL=

# WhatsApp Business (for assisted booking)
WHATSAPP_NUMBER="+213XXXXXXXXX"

# File Storage
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=nzzor-images

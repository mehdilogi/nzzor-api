# =============================================================================
# Nzzor API — Environment Configuration
# Operated by Allouni Travel Agency
# =============================================================================

# Brand
BRAND_NAME=Nzzor
LEGAL_OPERATOR="Allouni Travel Agency"
MINISTRY_AGREMENT_NUMBER="" # Fill in your Ministry of Tourism agrément number

# Database (PostgreSQL)
# For local development: createdb nzzor
DATABASE_URL="postgresql://postgres:password@localhost:5432/nzzor?schema=public"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Email (Resend transactional)
# Required for booking confirmation / status / payment emails. If unset,
# the API still works but emails are skipped (logged as "would have sent X").
RESEND_API_KEY=                       # re_xxxxxxxxxxxx — get from resend.com → API Keys
EMAIL_FROM="Nzzor <bookings@nzzor.com>"

# Web base URL — used in transactional emails to link back to the booking page
WEB_BASE_URL="https://nzzor.com"

# Payment Gateways (Phase 1 Step 7 — fill once SATIM merchant account is approved)
# SATIM_MERCHANT_ID=
# SATIM_TERMINAL_ID=
# SATIM_SECRET_KEY=
# SATIM_API_URL=
# EDDAHABIA_API_KEY=
# EDDAHABIA_API_URL=

# WhatsApp Business (for assisted booking)
WHATSAPP_NUMBER="+213XXXXXXXXX"

# File Storage (Cloudflare R2)
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=nzzor-hotels
# R2_PUBLIC_URL=
